# Copy to .env and fill in real values. Never commit .env.

# --- Application -------------------------------------------------------
# Product name shown in the API docs, health checks and emails
APP_NAME=Mindora AI
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (docker compose) ----------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_assistant
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag_assistant

# --- Redis: ingestion jobs, rate limiting, caches, processing state ------
# Host port 6380 by default (REDIS_HOST_PORT in docker-compose.yml); change both together.
REDIS_URL=redis://localhost:6380/0

# --- Auth ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI providers -------------------------------------------------------
# Which implementation serves each capability: see docs/providers.md.
# LLM: anthropic (Claude). Embeddings, reranking, STT and TTS are chosen further below.
LLM_PROVIDER=anthropic
LLM_API_KEY=
EMBEDDING_API_KEY=
STT_API_KEY=
TTS_API_KEY=
# Anthropic API key (console.anthropic.com) used for answers and image understanding.
# (LLM_API_KEY above.) Model and generation settings:
MODEL_NAME=claude-opus-5
LLM_MAX_TOKENS=16000
# Empty = API default (high). low/medium are faster and cheaper; measure before lowering.
LLM_EFFORT=
LLM_TIMEOUT_SECONDS=120
# Re-run a request the model declines on Anthropic's recommended fallback model.
LLM_REFUSAL_FALLBACK=true

# --- Embeddings ---------------------------------------------------------
# local  = fastembed on this machine (no key; model downloads once, ~65 MB)
# voyage = Voyage AI hosted API (set EMBEDDING_API_KEY)
EMBEDDING_PROVIDER=local
# Leave empty for the provider default (local: BAAI/bge-small-en-v1.5 / 384, voyage: voyage-3.5 / 1024).
EMBEDDING_MODEL=
# Must match the pgvector column size (384 in the current migrations). Changing it requires re-indexing.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64

# --- Ingestion ----------------------------------------------------------
# Documents processed concurrently in the background (CPU/memory bound).
INGESTION_WORKERS=1

# --- RAG ----------------------------------------------------------------
TOP_K=20
RERANK_TOP_K=5
# Near-duplicate passages (shingle Jaccard >= this) are removed; empty disables.
DEDUP_THRESHOLD=0.9
# Withhold reranked passages scoring below this. Empty (default) = off: measured to cost recall,
# see evaluation/results/experiment-rerank-threshold.md.
RERANK_MIN_SCORE=
# Upper bound on the characters of context sent with a question.
CONTEXT_MAX_CHARS=12000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Minimum cosine similarity for vector-only matches (measured for bge-small-en-v1.5;
# re-measure if you change the embedding model).
SIMILARITY_THRESHOLD=0.5
# How hybrid search merges its two lists: rrf (ranks only, measured best) or weighted
# (HYBRID_ALPHA * normalised similarity + (1 - HYBRID_ALPHA) * normalised keyword score).
RETRIEVAL_FUSION=rrf
HYBRID_ALPHA=0.5
# Cross-encoder reranking of the fused candidates (local = no API key; none = skip).
RERANKER_PROVIDER=local
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# --- Uploads ------------------------------------------------------------
# bytes (25 MB)
MAX_FILE_SIZE=26214400

# --- Speech-to-text -----------------------------------------------------
# local  = faster-whisper on this machine (no key; model downloads once, ~140 MB for "base")
# openai = OpenAI transcription API (set STT_API_KEY)
STT_PROVIDER=local
# Empty = provider default (local: base; others: tiny, small, medium, large-v3 / openai: whisper-1)
STT_MODEL=
# ISO 639-1 code (e.g. en) to force a language; empty = auto-detect
STT_LANGUAGE=
# Bytes (10 MB) and seconds per recording
MAX_AUDIO_SIZE=10485760
MAX_AUDIO_SECONDS=120

# --- Text-to-speech -----------------------------------------------------
# local  = Piper neural voice on this machine (no key; voice downloads once, ~63 MB)
# openai = OpenAI speech API (set TTS_API_KEY)
TTS_PROVIDER=local
# Empty = provider default (local: en_US-lessac-medium; see https://huggingface.co/rhasspy/piper-voices / openai: alloy)
TTS_VOICE=
# Longer answers are cut at a sentence boundary
TTS_MAX_CHARS=4000

# --- Images -------------------------------------------------------------
# Per image, bytes (5 MB). PNG, JPEG, GIF and WebP are accepted.
MAX_IMAGE_SIZE=5242880
MAX_IMAGES_PER_MESSAGE=4
# Long edge (px) of the copy sent to the model (Anthropic recommends <= 1568).
IMAGE_MODEL_MAX_EDGE=1568
MAX_HISTORY_IMAGES=4

# --- Document insights (AI summaries, key points, topics, keywords, entities) --
# Generated on request from a document's Details panel. true: also after every upload
# (each generation is one or more LLM calls, so this costs tokens per document).
DOCUMENT_INSIGHTS_AUTO=false
INSIGHTS_EFFORT=low
# Characters of text per LLM call; longer documents are analysed in parts, then merged.
INSIGHTS_CHARS_PER_CALL=60000
# Maximum parts; beyond that an even sample is analysed and the coverage is shown.
INSIGHTS_MAX_PARTS=6

# --- Email: welcome email on sign-up ------------------------------------
# Leave SMTP_HOST empty to turn email off (sign-up still works; nothing is sent).
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD
# (not your normal Gmail password). SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls for port 587, ssl for port 465
SMTP_SECURITY=starttls
# Sender shown to users; empty = SMTP_USERNAME. Gmail only sends from your own address.
EMAIL_FROM=
# Link used in emails: where users open the app
APP_PUBLIC_URL=http://localhost:8080

# --- Docker: `docker compose up -d --build` --------------------------------
# The app is served at http://localhost:$WEB_PORT. Inside the containers, DATABASE_URL,
# REDIS_URL, UPLOAD_DIR, MODEL_CACHE_DIR and CORS_ORIGINS are set by docker-compose.yml;
# the values above are for running the backend directly on your machine.
WEB_PORT=8080
REDIS_HOST_PORT=6380
# Browser-facing origin if it isn't http://localhost:$WEB_PORT (production: https://$DOMAIN).
# PUBLIC_ORIGIN=

# --- Production: docker-compose.prod.yml (see "Deployment" in README.md) -----
# Required there: DOMAIN, a strong JWT_SECRET and POSTGRES_PASSWORD. ENVIRONMENT is set to
# production automatically, which refuses to start with a weak JWT_SECRET.
# DOMAIN=rag.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
