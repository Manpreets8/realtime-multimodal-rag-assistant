# Template: ${VARIABLES} are filled from the environment when the container starts.
# Serves the built single-page app and proxies the API. The browser only ever talks to this
# server, so the app is same-origin: no CORS, and the WebSocket passes the Origin check.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Re-resolve the api's address through Docker's DNS: a recreated api container gets a new IP,
# and an address resolved once at startup would leave every request failing with 502.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api {
    zone api 64k;
    server api:8000 resolve;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;

    # Client address. X-Forwarded-For is believed only from TRUSTED_PROXY_CIDR: by default
    # nobody (this server is the edge), in production the TLS proxy's network
    # (docker-compose.prod.yml). Anyone else's header is ignored, and the API receives exactly
    # one address, so a client can't forge its own to slip past per-address rate limits.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Uploads: documents are limited to MAX_FILE_SIZE (25 MB) by the API; allow the multipart overhead.
    client_max_body_size 30m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- the app ---------------------------------------------------------------------------------
    # Only this origin's scripts and styles run; blob: covers downloaded images, speech audio and PDFs.
    # connect-src 'self' also allows the same-origin WebSocket (ws:/wss:) in current browsers.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    location / {
        try_files $uri /index.html;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        # The app records from the microphone (voice input); nothing else is allowed.
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()" always;
        add_header Cache-Control "no-cache" always;  # index.html: always check for a new release
    }

    # Hashed build output never changes: cache it for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- the API -----------------------------------------------------------------------------------
    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        # WebSocket upgrade for /api/v1/ws/chat (and keep-alive for everything else).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Longer than the API's own LLM timeout (120 s), so the API answers with its specific error.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Stream responses (WebSocket frames, downloads) instead of buffering them.
        proxy_buffering off;
    }

    # Interactive API docs (Swagger UI / ReDoc) and the schema they load.
    location ~ ^/(docs|redoc)(/|$) {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
